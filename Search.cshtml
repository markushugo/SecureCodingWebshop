@page "/search"
@model Webshop.UI.Pages.SearchModel
@{
    ViewData["Title"] = "Søgning";
}

<div class="container">
    <h1>Søg i produkter</h1>
    
    <form method="get">
        <div class="search-box">
            <input type="text" name="query" placeholder="Indtast søgeord..." value="@Model.Query" />
            <button type="submit">Søg</button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.Query))
    {
        if (Model.Products.Any())
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    <div class="product-card">
                        <h2>@Html.DisplayFor(modelItem => product.Name)</h2>
                        <p>@Html.DisplayFor(modelItem => product.Description)</p>
                        <p><strong>Pris:</strong> @Html.DisplayFor(modelItem => product.Price) DKK</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p>Ingen produkter fandt med søgeterm: "@Model.Query".</p>
        }
    }
</div>
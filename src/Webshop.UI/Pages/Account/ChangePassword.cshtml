@page
@model Webshop.UI.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Skift adgangskode"; }
<div class="panel"><h1>Skift adgangskode</h1><form method="post">
<div asp-validation-summary="ModelOnly"></div>
<label asp-for="Input.CurrentPassword">Nuværende adgangskode</label><input asp-for="Input.CurrentPassword" />
<label asp-for="Input.NewPassword">Ny adgangskode</label><input asp-for="Input.NewPassword" />
@if (Model.PasswordScore is int score) { <p>Serverberegnet styrke: <strong>@score/100</strong> – @(score < 50 ? "svag" : score < 80 ? "rimelig" : "stærk")</p> }
<label asp-for="Input.ConfirmPassword">Gentag ny adgangskode</label><input asp-for="Input.ConfirmPassword" />
<button>Gem ny adgangskode</button></form></div>

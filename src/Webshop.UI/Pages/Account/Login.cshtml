@page
@model Webshop.UI.Pages.Account.LoginModel
@{ ViewData["Title"] = "Log ind"; }
<div class="panel">
<h1>Log ind</h1>
<form method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Input.Email"></label><input asp-for="Input.Email" /><span asp-validation-for="Input.Email"></span>
    <label asp-for="Input.Password">Adgangskode</label><input asp-for="Input.Password" /><span asp-validation-for="Input.Password"></span>
    <button type="submit">Log ind</button>
</form>
</div>

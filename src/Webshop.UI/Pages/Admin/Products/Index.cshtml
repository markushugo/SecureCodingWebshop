@page
@model Webshop.UI.Pages.Admin.Products.IndexModel
@{ ViewData["Title"] = "Produkter – administration"; }
<div class="actions"><h1>Produkter</h1><a class="button" asp-page="Edit">Nyt produkt</a></div><table><thead><tr><th>Navn</th><th>Pris</th><th>Lager</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var product in Model.Products){<tr><td>@product.Name</td><td>@product.Price.ToString("C")</td><td>@product.Stock</td><td>@(product.IsActive ? "Aktiv" : "Inaktiv")</td><td class="actions"><a asp-page="Edit" asp-route-id="@product.Id">Rediger</a>@if(product.IsActive){<form method="post" asp-page-handler="Deactivate"><input type="hidden" name="id" value="@product.Id"/><button class="danger">Deaktiver</button></form>}else{<form method="post" asp-page-handler="Activate"><input type="hidden" name="id" value="@product.Id"/><button type="submit">Aktiver</button></form>}</td></tr>}</tbody></table>
